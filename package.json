{
  "name": "flow-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migration-status && next dev",
    "build": "NODE_ENV=production next build",
    "db:migration-status": "node scripts/check-prisma-migration-status.mjs",
    "vercel-build": "prisma migrate deploy && next build",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "typecheck": "NODE_ENV=production next typegen && rm -rf .next/dev/types && tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start": "npm run db:migration-status && next start",
    "lint": "eslint"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
