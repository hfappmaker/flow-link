generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  freelancer
  company_user
}

enum CompanyMemberRole {
  admin
  member
}

enum ResumeDocumentType {
  resume
  career_history
}

enum JobPostStatus {
  draft
  published
  private
  closed
}

enum ApplicationStatus {
  open
  paused
}

enum JobApplicationStatus {
  applied
  screening_passed
  screening_rejected
  withdrawn
}

enum NotificationType {
  screening_passed
  screening_rejected
  job_alert
  job_alert_digest
}

enum JobAlertCadence {
  immediate
  daily
  weekly
  paused
}

enum JobAlertMatchStatus {
  pending_digest
  notified
  suppressed
}

enum InterviewThreadStatus {
  open
  scheduled
  closed
}

enum InterviewMessageType {
  text
  proposed_time
  accepted_time
  meeting_url
}

enum InteractionFeedbackDirection {
  company_to_freelancer
  freelancer_to_company
}

enum InteractionFeedbackModerationStatus {
  visible
  reported
  hidden
}

enum PostInterviewOutcomeStatus {
  waiting_company_decision
  offer_sent
  freelancer_considering
  clarification_requested
  accepted
  declined_by_company
  declined_by_freelancer
  contract_preparing
  contract_agreed
  work_started
  closed_no_hire
}

enum PostInterviewDeclineReason {
  rate_mismatch
  workload_mismatch
  timing
  company_trust_concern
  contract_payment_concern
  role_mismatch
  accepted_elsewhere
  other
}

enum WorkPreferenceStatus {
  active
  passive
  inactive
}

enum WorkLocationMode {
  remote
  hybrid
  onsite
  flexible
}

enum CompanyVerificationKind {
  company_identity
  payment_policy
}

enum CompanyVerificationStatus {
  submitted
  confirmed
  rejected
  needs_renewal
}

enum CompanySafetyReportType {
  off_platform_payment_request
  suspicious_evidence
  unsafe_company
}

enum CompanySafetyReportStatus {
  submitted
  reviewing
  resolved
}

enum RecommendationFeedbackReason {
  good_fit
  not_relevant
  wrong_role_skill
  rate_mismatch
  workload_mismatch
  location_mismatch
  company_trust_concern
  already_handled
  hide_similar
}

enum RecommendationFeedbackSentiment {
  positive
  negative
  neutral
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String                @map("password_hash")
  role                UserRole
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  freelancer          FreelancerProfile?
  companyUser         CompanyUser?
  notifications       Notification[]
  messages            InterviewMessage[]
  interactionFeedback InteractionFeedback[]
  companySafetyReports CompanySafetyReport[]

  @@map("users")
}

model FreelancerProfile {
  id                String                @id @default(cuid())
  userId            String                @unique @map("user_id")
  fullName          String                @map("full_name")
  desiredOccupation String?               @map("desired_occupation")
  skills            String?
  yearsOfExperience Int?                  @map("years_of_experience")
  desiredRate       String?               @map("desired_rate")
  availability      String?
  availableFrom     String?               @map("available_from")
  preferredLocation String?               @map("preferred_location")
  remotePreference  String?               @map("remote_preference")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         ResumeDocument[]
  careerHistory     CareerHistory?
  applications      JobApplication[]
  savedJobs         SavedJob[]
  workPreference    WorkPreference?
  savedJobSearches  SavedJobSearch[]
  jobAlertMatches   JobAlertMatch[]
  recommendationFeedback RecommendationFeedback[]
  receivedFeedback  InteractionFeedback[] @relation("FeedbackForFreelancer")

  @@map("freelancer_profiles")
}

model WorkPreference {
  id                  String               @id @default(cuid())
  freelancerProfileId String               @unique @map("freelancer_profile_id")
  status              WorkPreferenceStatus @default(active)
  targetRole          String?              @map("target_role")
  preferredSkills     String?              @map("preferred_skills")
  targetRate          String?              @map("target_rate")
  workload            String?
  locationMode        WorkLocationMode     @default(flexible) @map("location_mode")
  preferredLocation   String?              @map("preferred_location")
  availableFrom       String?              @map("available_from")
  excludedConditions  String?              @map("excluded_conditions")
  notificationCadence String?              @map("notification_cadence")
  privateNotes        String?              @map("private_notes")
  lastConfirmedAt     DateTime?            @map("last_confirmed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile    @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@map("work_preferences")
}

model SavedJobSearch {
  id                  String            @id @default(cuid())
  freelancerProfileId String            @map("freelancer_profile_id")
  name                String
  query               String?
  remote              Boolean           @default(false)
  acceptingOnly       Boolean           @default(true) @map("accepting_only")
  directReadyOnly     Boolean           @default(false) @map("direct_ready_only")
  fit                 String?
  workload            String?
  rate                String?
  sort                String            @default("direct")
  notificationCadence JobAlertCadence   @default(immediate) @map("notification_cadence")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  alertMatches        JobAlertMatch[]

  @@index([freelancerProfileId])
  @@map("saved_job_searches")
}

model ResumeDocument {
  id                  String             @id @default(cuid())
  freelancerProfileId String             @map("freelancer_profile_id")
  documentType        ResumeDocumentType @map("document_type")
  fileUrl             String             @map("file_url")
  originalFilename    String             @map("original_filename")
  uploadedAt          DateTime           @default(now()) @map("uploaded_at")
  freelancerProfile   FreelancerProfile  @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, documentType])
  @@map("resume_documents")
}

model CareerHistory {
  id                  String            @id @default(cuid())
  freelancerProfileId String            @unique @map("freelancer_profile_id")
  summary             String?
  workExperiences     String?           @map("work_experiences")
  projects            String?
  certifications      String?
  education           String?
  updatedAt           DateTime          @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@map("career_histories")
}

model CompanyProfile {
  id                           String                @id @default(cuid())
  name                         String
  description                  String?
  websiteUrl                   String?               @map("website_url")
  contactTeam                  String?               @map("contact_team")
  operatingArea                String?               @map("operating_area")
  paymentPolicy                String?               @map("payment_policy")
  flowLinkReviewedCompanyAt    DateTime?             @map("flow_link_reviewed_company_at")
  flowLinkReviewedCompanyScope String?               @map("flow_link_reviewed_company_scope")
  flowLinkReviewedPaymentAt    DateTime?             @map("flow_link_reviewed_payment_at")
  flowLinkReviewedPaymentScope String?               @map("flow_link_reviewed_payment_scope")
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")
  users                        CompanyUser[]
  jobPosts                     JobPost[]
  receivedFeedback             InteractionFeedback[] @relation("FeedbackForCompany")
  verificationRequests         CompanyVerificationRequest[]
  safetyReports                CompanySafetyReport[]

  @@map("company_profiles")
}

model CompanyUser {
  id               String            @id @default(cuid())
  userId           String            @unique @map("user_id")
  companyProfileId String            @map("company_profile_id")
  role             CompanyMemberRole @default(admin)
  createdAt        DateTime          @default(now()) @map("created_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfile   CompanyProfile    @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  screenedApps     JobApplication[]  @relation("ScreenedBy")
  notes            ScreeningNote[]
  verificationRequests CompanyVerificationRequest[]

  @@map("company_users")
}

model CompanyVerificationRequest {
  id                       String                    @id @default(cuid())
  companyProfileId         String                    @map("company_profile_id")
  requestedByCompanyUserId String                    @map("requested_by_company_user_id")
  kind                     CompanyVerificationKind
  status                   CompanyVerificationStatus @default(submitted)
  publicEvidenceUrl        String?                   @map("public_evidence_url")
  contactEvidence          String?                   @map("contact_evidence")
  contractEvidence         String?                   @map("contract_evidence")
  paymentEvidence          String?                   @map("payment_evidence")
  offPlatformPolicy        String?                   @map("off_platform_policy")
  evidenceSummary          String                    @map("evidence_summary")
  confirmedScope           String?                   @map("confirmed_scope")
  reviewerNotes            String?                   @map("reviewer_notes")
  reasonCode               String?                   @map("reason_code")
  reviewedAt               DateTime?                 @map("reviewed_at")
  expiresAt                DateTime?                 @map("expires_at")
  renewalRequestedAt       DateTime?                 @map("renewal_requested_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  companyProfile           CompanyProfile            @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  requestedByCompanyUser   CompanyUser               @relation(fields: [requestedByCompanyUserId], references: [id], onDelete: Cascade)

  @@index([companyProfileId, kind, status])
  @@map("company_verification_requests")
}

model CompanySafetyReport {
  id               String                    @id @default(cuid())
  companyProfileId String                    @map("company_profile_id")
  reporterUserId   String?                   @map("reporter_user_id")
  jobPostId        String?                   @map("job_post_id")
  reportType       CompanySafetyReportType   @map("report_type")
  status           CompanySafetyReportStatus @default(submitted)
  detail           String
  internalNote     String?                   @map("internal_note")
  affectedUserNote String?                   @map("affected_user_note")
  resolvedAt       DateTime?                 @map("resolved_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  companyProfile   CompanyProfile            @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  reporterUser     User?                     @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)
  jobPost          JobPost?                  @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([companyProfileId, status])
  @@index([reportType, status])
  @@map("company_safety_reports")
}

model JobPost {
  id                String            @id @default(cuid())
  companyProfileId  String            @map("company_profile_id")
  title             String
  description       String
  requiredSkills    String?           @map("required_skills")
  preferredSkills   String?           @map("preferred_skills")
  rate              String?
  workload          String?
  contractPeriod    String?           @map("contract_period")
  selectionFlow     String?           @map("selection_flow")
  contractTerms     String?           @map("contract_terms")
  location          String?
  remotePolicy      String?           @map("remote_policy")
  openings          Int?
  status            JobPostStatus     @default(draft)
  applicationStatus ApplicationStatus @default(open) @map("application_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  companyProfile    CompanyProfile    @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  applications      JobApplication[]
  savedJobs         SavedJob[]
  safetyReports     CompanySafetyReport[]
  recommendationFeedback RecommendationFeedback[]
  alertMatches      JobAlertMatch[]

  @@map("job_posts")
}

model SavedJob {
  id                  String            @id @default(cuid())
  freelancerProfileId String            @map("freelancer_profile_id")
  jobPostId           String            @map("job_post_id")
  note                String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  jobPost             JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, jobPostId])
  @@map("saved_jobs")
}

model RecommendationFeedback {
  id                  String                          @id @default(cuid())
  freelancerProfileId String                          @map("freelancer_profile_id")
  jobPostId           String                          @map("job_post_id")
  reason              RecommendationFeedbackReason
  sentiment           RecommendationFeedbackSentiment
  hideSimilar         Boolean                         @default(false) @map("hide_similar")
  visibleReasons      String?                         @map("visible_reasons")
  source              String
  sourceContext       String?                         @map("source_context")
  note                String?
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile               @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  jobPost             JobPost                         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, jobPostId])
  @@index([jobPostId, reason])
  @@index([freelancerProfileId, reason, hideSimilar])
  @@map("recommendation_feedback")
}

model JobApplication {
  id                      String                @id @default(cuid())
  jobPostId               String                @map("job_post_id")
  freelancerProfileId     String                @map("freelancer_profile_id")
  status                  JobApplicationStatus  @default(applied)
  proposalMessage         String?               @map("proposal_message")
  proposedStart           String?               @map("proposed_start")
  contactPreference       String?               @map("contact_preference")
  appliedAt               DateTime              @default(now()) @map("applied_at")
  screenedAt              DateTime?             @map("screened_at")
  screenedByCompanyUserId String?               @map("screened_by_company_user_id")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  jobPost                 JobPost               @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  freelancerProfile       FreelancerProfile     @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  screenedBy              CompanyUser?          @relation("ScreenedBy", fields: [screenedByCompanyUserId], references: [id])
  notes                   ScreeningNote[]
  interviewThread         InterviewThread?
  interactionFeedback     InteractionFeedback[]
  postInterviewOutcome    PostInterviewOutcome?

  @@unique([jobPostId, freelancerProfileId])
  @@map("job_applications")
}

model ScreeningNote {
  id               String         @id @default(cuid())
  jobApplicationId String         @map("job_application_id")
  companyUserId    String         @map("company_user_id")
  note             String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  companyUser      CompanyUser    @relation(fields: [companyUserId], references: [id], onDelete: Cascade)

  @@map("screening_notes")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  actionUrl String?          @map("action_url")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlertMatches JobAlertMatch[]

  @@map("notifications")
}

model JobAlertMatch {
  id                  String              @id @default(cuid())
  freelancerProfileId String              @map("freelancer_profile_id")
  savedJobSearchId    String              @map("saved_job_search_id")
  jobPostId           String              @map("job_post_id")
  notificationId      String?             @map("notification_id")
  cadence             JobAlertCadence
  status              JobAlertMatchStatus @default(pending_digest)
  fitReasons          String              @map("fit_reasons")
  trustWarning        String?             @map("trust_warning")
  suppressionReason   String?             @map("suppression_reason")
  matchedAt           DateTime            @default(now()) @map("matched_at")
  notifiedAt          DateTime?           @map("notified_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  freelancerProfile   FreelancerProfile   @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  savedJobSearch      SavedJobSearch      @relation(fields: [savedJobSearchId], references: [id], onDelete: Cascade)
  jobPost             JobPost             @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  notification        Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([savedJobSearchId, jobPostId])
  @@index([freelancerProfileId, status, cadence])
  @@index([jobPostId])
  @@map("job_alert_matches")
}

model InterviewThread {
  id               String                @id @default(cuid())
  jobApplicationId String                @unique @map("job_application_id")
  status           InterviewThreadStatus @default(open)
  scheduledAt      DateTime?             @map("scheduled_at")
  meetingUrl       String?               @map("meeting_url")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  jobApplication   JobApplication        @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  messages         InterviewMessage[]

  @@map("interview_threads")
}

model InterviewMessage {
  id                String               @id @default(cuid())
  interviewThreadId String               @map("interview_thread_id")
  senderUserId      String               @map("sender_user_id")
  messageType       InterviewMessageType @default(text) @map("message_type")
  body              String
  proposedAt        DateTime?            @map("proposed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  interviewThread   InterviewThread      @relation(fields: [interviewThreadId], references: [id], onDelete: Cascade)
  sender            User                 @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@map("interview_messages")
}

model InteractionFeedback {
  id                        String                              @id @default(cuid())
  jobApplicationId          String                              @map("job_application_id")
  authorUserId              String                              @map("author_user_id")
  direction                 InteractionFeedbackDirection
  targetCompanyProfileId    String?                             @map("target_company_profile_id")
  targetFreelancerProfileId String?                             @map("target_freelancer_profile_id")
  followThroughRating       Int                                 @map("follow_through_rating")
  collaborationRating       Int                                 @map("collaboration_rating")
  interactionCompleted      Boolean                             @default(false) @map("interaction_completed")
  wouldWorkAgain            Boolean?                            @map("would_work_again")
  privateNote               String?                             @map("private_note")
  moderationStatus          InteractionFeedbackModerationStatus @default(visible) @map("moderation_status")
  createdAt                 DateTime                            @default(now()) @map("created_at")
  updatedAt                 DateTime                            @updatedAt @map("updated_at")
  jobApplication            JobApplication                      @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  author                    User                                @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  targetCompanyProfile      CompanyProfile?                     @relation("FeedbackForCompany", fields: [targetCompanyProfileId], references: [id], onDelete: Cascade)
  targetFreelancerProfile   FreelancerProfile?                  @relation("FeedbackForFreelancer", fields: [targetFreelancerProfileId], references: [id], onDelete: Cascade)

  @@unique([jobApplicationId, direction, authorUserId])
  @@index([targetCompanyProfileId, moderationStatus])
  @@index([targetFreelancerProfileId, moderationStatus])
  @@map("interaction_feedback")
}

model PostInterviewOutcome {
  id                         String                       @id @default(cuid())
  jobApplicationId           String                       @unique @map("job_application_id")
  status                     PostInterviewOutcomeStatus   @default(waiting_company_decision)
  proposedStartDate          String?                      @map("proposed_start_date")
  agreedStartDate            String?                      @map("agreed_start_date")
  agreedRate                 String?                      @map("agreed_rate")
  agreedWorkload             String?                      @map("agreed_workload")
  contractPaymentNotes       String?                      @map("contract_payment_notes")
  externalConfirmationNeeded String?                      @map("external_confirmation_needed")
  responseDeadline           String?                      @map("response_deadline")
  declineReason              PostInterviewDeclineReason?  @map("decline_reason")
  privateOutcomeNote         String?                      @map("private_outcome_note")
  jobShouldStayOpen          Boolean?                     @map("job_should_stay_open")
  companyUpdatedAt           DateTime?                    @map("company_updated_at")
  freelancerUpdatedAt        DateTime?                    @map("freelancer_updated_at")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  jobApplication             JobApplication               @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("post_interview_outcomes")
}
