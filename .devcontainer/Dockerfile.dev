FROM node:24-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        bubblewrap \
        cron \
        curl \
        git \
        gpg \
        openssh-server \
        postgresql-client \
        procps \
        ripgrep \
        sudo \
    && mkdir -p -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && mkdir -p /var/run/sshd /etc/ssh/sshd_config.d \
    && echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node \
    && chmod 0440 /etc/sudoers.d/node \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g vercel @openai/codex

COPY sshd_config.conf /etc/ssh/sshd_config.d/flow-link.conf
COPY flow-link-codex-issue-loops.cron /etc/cron.d/flow-link-codex-issue-loops
COPY entrypoint.sh /usr/local/bin/flow-link-devcontainer-entrypoint
RUN chmod 0644 /etc/cron.d/flow-link-codex-issue-loops \
    && ln -sf /usr/bin/bwrap /usr/local/bin/bubblewrap \
    && chmod +x /usr/local/bin/flow-link-devcontainer-entrypoint

ENTRYPOINT ["/usr/local/bin/flow-link-devcontainer-entrypoint"]
CMD ["/usr/sbin/sshd", "-D", "-e"]
