DATABASE_URL="postgresql://flowlink:flowlink@db:5432/flow_link?schema=public"
# Optional in serverless deployments: pooled app-runtime connection string.
# Keep migration/direct-role URLs in DATABASE_URL and use this for page reads.
PRISMA_RUNTIME_DATABASE_URL=""
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
BLOB_READ_WRITE_TOKEN="vercel-blob-token"
